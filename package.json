{
  "name": "spontai-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=./dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "types:cf": "wrangler types",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.26",
    "@scalar/hono-api-reference": "^0.10.13",
    "@sentry/cloudflare": "^10.51.0",
    "@supabase/supabase-js": "^2.105.1",
    "@types/node": "^25.9.2",
    "@upstash/redis": "^1.37.0",
    "agents": "^0.12.3",
    "aws4fetch": "^1.0.20",
    "hono": "^4.12.16",
    "jose": "^6.2.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4",
    "@cloudflare/workers-types": "^4.20260502.1",
    "lefthook": "^1.7",
    "typescript": "^5.7",
    "wrangler": "^4.87"
  }
}
